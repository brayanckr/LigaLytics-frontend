# URL base de la API del backend (Spring Boot)
VITE_API_BASE_URL=http://localhost:8080/api

# Solo en Vercel con el reenvio de /api (ver README): la API se llama por la ruta relativa
#   VITE_API_BASE_URL=/api
# y el canal en vivo (WebSocket, que Vercel no reenvia) se conecta directo al backend:
#   VITE_LIVE_BASE_URL=https://<tu-backend>.up.railway.app/api
