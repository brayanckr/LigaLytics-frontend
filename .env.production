# Build de produccion (Vercel). Son URLs publicas, no secretos.
# La API se llama por /api en el propio dominio y Vercel la reenvia a Railway (ver vercel.json): asi la cookie de
# sesion es del dominio de la app y no depende de cookies de terceros.
VITE_API_BASE_URL=/api
# Vercel no reenvia WebSockets: el canal en vivo (sin cookies) se conecta directo al backend.
VITE_LIVE_BASE_URL=https://ligalytics-api-production.up.railway.app/api
